# Salin file ini jadi ".env" lalu isi datamu sendiri

# Nomor WA bot (pakai kode negara, tanpa + dan tanpa spasi) contoh: 6281234567890
BOT_NUMBER=6281234567890

# Nomor owner/admin (yang boleh pakai command khusus)
OWNER_NUMBER=6281234567890

# API Key untuk fitur AI Chat
# Bisa pakai provider apapun yang OpenAI-compatible (OpenAI, Groq, OpenRouter, dll)
AI_API_KEY=isi_api_key_kamu_disini
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.1-8b-instant

# Nama toko
STORE_NAME=Tarz Store

# Opsional: hanya diisi kalau deploy ke Railway dengan Volume (lihat DEPLOY.md)
# SESSION_PATH=/app/session
